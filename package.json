{
  "name": "gp-procurement-portal",
  "version": "1.0.0",
  "description": "West Bengal Gram Panchayat Procurement, Tender, Work, Billing, Payment, Audit & Reporting Management Portal",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/db/seed.js",
    "seed:reset": "node src/db/seed.js --reset",
    "backup": "node src/scripts/backup.js",
    "test": "node --test --test-concurrency=1 --test-reporter=spec",
    "demo": "node src/db/demo.js",
    "demo:reset": "node src/db/demo.js --reset",
    "lint": "eslint ."
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.1"
  },
  "devDependencies": {
    "eslint": "^9.19.0",
    "supertest": "^7.0.0"
  }
}
