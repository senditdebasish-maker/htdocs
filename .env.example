# =============================================================================
# Gram Panchayat Procurement & Work Management Portal — Environment Variables
# Copy to .env and adjust for the deployment environment.
# =============================================================================

# HTTP
PORT=3000
HOST=0.0.0.0

# Base URL used to build absolute links (document QR/verification codes, emails)
BASE_URL=http://localhost:3000

# Node environment: development | test | production
NODE_ENV=development

# Session secret — REQUIRED. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-hex-string

# Cookie settings
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_MAX_AGE_MS=28800000

# Database (SQLite). Path relative to the repository root.
DATABASE_PATH=data/app.db

# File storage root (uploaded documents, generated PDFs)
DATA_DIR=data

# Maximum file upload size in bytes (default 25 MB)
MAX_UPLOAD_BYTES=26214400

# Trust proxy (set to 1 when behind the Arena/e2b preview proxy so client IPs/logs are correct)
TRUST_PROXY=1

# Enable rate limiting on auth endpoints
RATE_LIMIT_ENABLED=true

# Seeding: set SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD to control the first admin.
SEED_ADMIN_EMAIL=admin@panchayat.local
SEED_ADMIN_PASSWORD=ChangeMe@12345
