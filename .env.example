# GP Tender Portal environment overrides (optional)
# Copy the variables you need into your Apache/XAMPP environment or edit config.php locally.

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gp_portal
DB_USER=root
DB_PASS=
DB_SQLITE_FILE=C:/xampp/htdocs/gp-tender/data/app.db

APP_TIMEZONE=Asia/Kolkata
SESSION_COOKIE_SECURE=0
SESSION_LIFETIME=28800
MAX_UPLOAD_BYTES=26214400
RATE_LIMIT_ENABLED=1
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=900

# Used only by CLI seed.php on first install. The web installer asks for a password instead.
SEED_ADMIN_EMAIL=admin@panchayat.local
SEED_ADMIN_PASSWORD=

# Optional: move runtime data outside the web tree if your XAMPP policy allows it.
# DATA_DIR=C:/xampp/gp-tender-data
