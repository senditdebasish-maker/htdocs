<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { title: 'Reports' }) %></head>
<body>
<div class="layout">
  <%- include('partials/sidebar') %>
  <div class="main">
    <%- include('partials/topbar', { breadcrumbs: [{ label: 'Reports' }] }) %>
    <div class="content">
      <h1 class="page-title">Reports</h1>
      <p class="page-sub">Registers and reconciliation. Reports reconcile against source records.</p>
      <div class="form-row" style="grid-template-columns:200px auto">
        <div class="field"><label>Financial Year</label><select id="f-fy" onchange="loadAll()"><option value="">All years</option></select></div>
      </div>

      <div class="tabs" id="tabs">
        <div class="tab active" data-tab="reg">Tender Register</div>
        <div class="tab" data-tab="bills">Bill Register</div>
        <div class="tab" data-tab="pay">Payment Register</div>
        <div class="tab" data-tab="recon">Reconciliation</div>
        <div class="tab" data-tab="dim">By Scheme / Fund</div>
      </div>
      <div class="tab-pane active" id="pane-reg"><div class="panel"><div class="panel-body no-pad"><div class="table-wrap"><table class="table"><thead><tr><th>Tender No.</th><th>Work</th><th>FY</th><th>Scheme</th><th>Fund</th><th class="num">Estimated</th><th>Bidders</th><th>Status</th></tr></thead><tbody id="reg-rows"></tbody></table></div></div></div></div>
      <div class="tab-pane" id="pane-bills"><div class="panel"><div class="panel-body no-pad"><div class="table-wrap"><table class="table"><thead><tr><th>Bill No.</th><th>Work</th><th>FY</th><th class="num">Gross</th><th class="num">Net Payable</th><th>Status</th></tr></thead><tbody id="bill-rows"></tbody></table></div></div></div></div>
      <div class="tab-pane" id="pane-pay"><div class="panel"><div class="panel-body no-pad"><div class="table-wrap"><table class="table"><thead><tr><th>Voucher</th><th>Date</th><th>Work</th><th class="num">Net</th><th>Method</th><th>Status</th></tr></thead><tbody id="pay-rows"></tbody></table></div></div></div></div>
      <div class="tab-pane" id="pane-recon"><div class="panel"><div class="panel-body no-pad"><div class="table-wrap"><table class="table"><thead><tr><th>Tender</th><th class="num">Estimate</th><th class="num">Awarded</th><th class="num">Certified</th><th class="num">Paid</th><th>Check</th></tr></thead><tbody id="recon-rows"></tbody></table></div></div></div></div>
      <div class="tab-pane" id="pane-dim"><div class="grid-2"><div class="panel"><div class="panel-head">By Scheme</div><div class="panel-body no-pad"><table class="table" id="dim-scheme"></table></div></div><div class="panel"><div class="panel-head">By Fund</div><div class="panel-body no-pad"><table class="table" id="dim-fund"></table></div></div></div></div>
    </div>
  </div>
</div>
<%- include('partials/scripts') %>
<script>
  const fy = () => document.getElementById('f-fy').value;
  async function loadAll() {
    const q = 'fyId=' + (fy() || '');
    const [t, b, p, r] = await Promise.all([
      API.get('/api/reports/tenders?' + q), API.get('/api/reports/bills?' + q), API.get('/api/reports/payments?' + q), API.get('/api/reports/reconciliation?' + q),
    ]);
    document.getElementById('reg-rows').innerHTML = t.data.rows.map(x => `<tr><td class="mono">${esc(x.tender_number)}</td><td>${esc(x.work_name || x.title)}</td><td>${esc(x.fy_label)}</td><td>${esc(x.scheme_name || '—')}</td><td>${esc(x.fund_name || '—')}</td><td class="num">${fmtINR((x.estimated_cost_minor || 0) / 100)}</td><td>${x.bidder_count}</td><td><span class="badge ${x.status}">${x.status.replace(/_/g, ' ')}</span></td></tr>`).join('') || '<tr><td colspan="8" class="muted">No tenders</td></tr>';
    document.getElementById('bill-rows').innerHTML = b.data.rows.map(x => `<tr><td class="mono">${esc(x.bill_number)}</td><td>${esc(x.work_name || '')}</td><td>${esc(x.fy_label)}</td><td class="num">${fmtINR((x.gross_work_value_minor || 0) / 100)}</td><td class="num">${fmtINR((x.net_payable_minor || 0) / 100)}</td><td><span class="badge ${x.status}">${x.status}</span></td></tr>`).join('') || '<tr><td colspan="6" class="muted">No bills</td></tr>';
    document.getElementById('pay-rows').innerHTML = p.data.rows.map(x => `<tr><td class="mono">${esc(x.voucher_no)}</td><td>${fmtDate(x.payment_date)}</td><td>${esc(x.work_name || '')}</td><td class="num">${fmtINR((x.net_amount_minor || 0) / 100)}</td><td>${esc(x.payment_method || '—')}</td><td><span class="badge ${x.status}">${x.status}</span></td></tr>`).join('') || '<tr><td colspan="6" class="muted">No payments</td></tr>';
    document.getElementById('recon-rows').innerHTML = r.data.map(x => {
      const awarded = x.awarded_minor || 0, paid = x.paid_minor || 0, certified = x.certified_minor || 0, est = x.estimated_cost_minor || 0;
      const issue = paid > certified ? '<span class="badge blocking">Paid > Certified</span>' : (certified > est ? '<span class="badge warning">Certified > Estimate</span>' : '<span class="badge passed">OK</span>');
      return `<tr><td class="mono">${esc(x.tender_number)}</td><td class="num">${fmtINR(est / 100)}</td><td class="num">${fmtINR(awarded / 100)}</td><td class="num">${fmtINR(certified / 100)}</td><td class="num">${fmtINR(paid / 100)}</td><td>${issue}</td></tr>`;
    }).join('') || '<tr><td colspan="6" class="muted">No data</td></tr>';
    const [ds, df] = await Promise.all([API.get('/api/reports/dimension/scheme?' + q), API.get('/api/reports/dimension/fund?' + q)]);
    document.getElementById('dim-scheme').innerHTML = '<thead><tr><th>Scheme</th><th>Count</th><th class="num">Value</th></tr></thead><tbody>' + ds.data.map(x => `<tr><td>${esc(x.label)}</td><td>${x.c}</td><td class="num">${fmtINR((x.value || 0) / 100)}</td></tr>`).join('') + '</tbody>';
    document.getElementById('dim-fund').innerHTML = '<thead><tr><th>Fund</th><th>Count</th><th class="num">Value</th></tr></thead><tbody>' + df.data.map(x => `<tr><td>${esc(x.label)}</td><td>${x.c}</td><td class="num">${fmtINR((x.value || 0) / 100)}</td></tr>`).join('') + '</tbody>';
  }
  document.getElementById('tabs').addEventListener('click', (e) => {
    const tab = e.target.closest('.tab'); if (!tab) return;
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.tab-pane').forEach(t => t.classList.remove('active'));
    tab.classList.add('active'); document.getElementById('pane-' + tab.dataset.tab).classList.add('active');
  });
  (async function init() {
    const r = await API.get('/api/reference');
    document.getElementById('f-fy').innerHTML = '<option value="">All years</option>' + r.data.financialYears.map(f => `<option value="${f.id}" ${f.is_current ? 'selected' : ''}>${f.label}</option>`).join('');
    loadAll();
  })();
</script>
</body>
</html>
