<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Tenders' }) %>
</head>
<body>
<div class="layout">
  <%- include('partials/sidebar') %>
  <div class="main">
    <%- include('partials/topbar', { breadcrumbs: [{ label: 'Tenders' }] }) %>
    <div class="content">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px">
        <div>
          <h1 class="page-title">Tenders</h1>
          <p class="page-sub">Full tender lifecycle: draft → award → work order → completion</p>
        </div>
        <a href="/tenders/new" class="btn primary">+ New Tender</a>
      </div>

      <div class="panel">
        <div class="panel-body">
          <div class="form-row" style="grid-template-columns:repeat(auto-fit,minmax(170px,1fr))">
            <div class="field"><label>Financial Year</label><select id="f-fy" onchange="load()"><option value="">All</option></select></div>
            <div class="field"><label>Status</label><select id="f-status" onchange="load()">
              <option value="">All</option>
              <option>draft</option><option>under_approval</option><option>approved</option><option>nit_generated</option>
              <option>published</option><option>bidding</option><option>bid_closed</option><option>technical_evaluation</option>
              <option>financial_evaluation</option><option>awarded</option><option>cancelled</option><option>retendered</option><option>closed</option>
            </select></div>
            <div class="field"><label>Tender Type</label><select id="f-type" onchange="load()">
              <option value="">All</option>
              <option>open</option><option>limited</option><option>e-tender</option><option>quotation</option>
              <option>short_notice</option><option>retender</option><option>single</option>
            </select></div>
            <div class="field"><label>Search</label><input type="text" id="f-q" placeholder="Number / title…" onkeyup="debouncedLoad()"></div>
          </div>
          <div class="table-wrap">
            <table class="table">
              <thead><tr><th>Tender No.</th><th>Work</th><th>Type</th><th>FY</th><th class="num">Estimated</th><th>Status</th><th>Compliance</th><th></th></tr></thead>
              <tbody id="rows"></tbody>
            </table>
          </div>
          <div class="btn-row" style="margin-top:12px">
            <button class="btn sm" onclick="prev()">← Prev</button>
            <button class="btn sm" onclick="next()">Next →</button>
            <span id="page-info" class="muted"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('partials/scripts') %>
<script>
  let offset = 0, total = 0, qTimer;
  function debouncedLoad() { clearTimeout(qTimer); qTimer = setTimeout(load, 300); }
  function query() {
    const p = new URLSearchParams({ limit: 25, offset });
    if (fySel()) p.set('fyId', fySel());
    if (document.getElementById('f-status').value) p.set('status', document.getElementById('f-status').value);
    if (document.getElementById('f-type').value) p.set('type', document.getElementById('f-type').value);
    if (document.getElementById('f-q').value) p.set('q', document.getElementById('f-q').value);
    return p;
  }
  function fySel() { return document.getElementById('f-fy').value; }
  async function load() {
    const d = await API.get('/api/tenders?' + query().toString());
    total = d.data.total;
    const rows = d.data.rows;
    document.getElementById('rows').innerHTML = rows.length ? rows.map(t => `
      <tr>
        <td class="mono">${esc(t.tender_number)}</td>
        <td>${esc(t.work_name || t.title)}</td>
        <td>${esc(t.tender_type)}</td>
        <td>${esc(t.fy_label)}</td>
        <td class="num">${fmtINR((t.estimated_cost_minor || 0) / 100)}</td>
        <td><span class="badge ${t.status}">${t.status.replace(/_/g, ' ')}</span></td>
        <td>${t.compliance_status === 'not_evaluated' ? '<span class="muted">—</span>' : `<span class="badge ${t.compliance_status}">${t.compliance_status}</span>`}</td>
        <td><a class="btn sm" href="/tenders/${t.id}">Open</a></td>
      </tr>`).join('') : '<tr><td colspan="8"><div class="empty"><div class="big">📄</div>No tenders match the filters.</div></td></tr>';
    document.getElementById('page-info').textContent = `Showing ${offset + 1}–${Math.min(offset + 25, total)} of ${total}`;
  }
  function next() { if (offset + 25 < total) { offset += 25; load(); } }
  function prev() { if (offset >= 25) { offset -= 25; load(); } }
  (async function init() {
    const ref = await API.get('/api/reference');
    document.getElementById('f-fy').innerHTML = '<option value="">All</option>' + ref.data.financialYears.map(f => `<option value="${f.id}">${f.label}</option>`).join('');
    load();
  })();
</script>
</body>
</html>
