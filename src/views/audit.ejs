<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { title: 'Audit Trail' }) %></head>
<body>
<div class="layout">
  <%- include('partials/sidebar') %>
  <div class="main">
    <%- include('partials/topbar', { breadcrumbs: [{ label: 'Audit Trail' }] }) %>
    <div class="content">
      <h1 class="page-title">Audit Trail</h1>
      <p class="page-sub">Append-only record of every important action. Who changed what, when, and why.</p>
      <div class="panel"><div class="panel-body">
        <div class="form-row" style="grid-template-columns:1fr 1fr 1fr">
          <div class="field"><label>Entity Type</label><input id="f-et" placeholder="tender, bill…"></div>
          <div class="field"><label>Action</label><input id="f-action" placeholder="tender.create…"></div>
          <div class="field"><label>Search</label><input id="f-q" placeholder="label / actor…"></div>
        </div>
        <button class="btn primary" onclick="load()">Apply</button>
      </div></div>
      <div class="panel"><div class="panel-body no-pad"><div class="table-wrap"><table class="table">
        <thead><tr><th>When</th><th>Actor</th><th>Action</th><th>Entity</th><th>Label</th><th>Reason</th></tr></thead>
        <tbody id="rows"></tbody>
      </table></div></div></div>
    </div>
  </div>
</div>
<%- include('partials/scripts') %>
<script>
  async function load() {
    const p = new URLSearchParams();
    if (document.getElementById('f-et').value) p.set('entityType', document.getElementById('f-et').value);
    if (document.getElementById('f-action').value) p.set('action', document.getElementById('f-action').value);
    if (document.getElementById('f-q').value) p.set('q', document.getElementById('f-q').value);
    const d = await API.get('/api/audit?' + p.toString());
    document.getElementById('rows').innerHTML = d.data.rows.map(a => `<tr>
      <td class="mono">${a.created_at}</td>
      <td>${esc(a.actor_name || 'system')}</td>
      <td><strong>${esc(a.action)}</strong></td>
      <td>${esc(a.entity_type)}${a.entity_id ? ' #' + a.entity_id : ''}</td>
      <td>${esc(a.entity_label || '')}</td>
      <td class="muted">${esc(a.reason || '')}</td>
    </tr>`).join('') || '<tr><td colspan="6"><div class="empty">No audit events</div></td></tr>';
  }
  load();
</script>
</body>
</html>
