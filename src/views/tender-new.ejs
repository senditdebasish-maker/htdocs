<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'New Tender' }) %>
</head>
<body>
<div class="layout">
  <%- include('partials/sidebar') %>
  <div class="main">
    <%- include('partials/topbar', { breadcrumbs: [{ label: 'Tenders', url: '/tenders' }, { label: 'New Tender' }] }) %>
    <div class="content narrow">
      <h1 class="page-title">New Tender — Wizard</h1>
      <p class="page-sub">Complete each step. Required fields are marked <span class="req">*</span>. Compliance checks run before submission.</p>
      <div id="toasts"></div>

      <div class="wizard-steps" id="wiz-steps"></div>
      <div class="wizard-body" id="wiz-body"></div>
      <div class="btn-row" style="margin-top:16px;justify-content:space-between">
        <button class="btn" id="btn-prev" onclick="go(step-1)">← Back</button>
        <button class="btn primary" id="btn-next" onclick="goNext()">Next →</button>
      </div>
    </div>
  </div>
</div>
<%- include('partials/scripts') %>
<script>
  const STEPS = ['Basic Information', 'Approvals', 'Financial', 'Technical & BOQ', 'Eligibility & Schedule', 'Conditions', 'Documents', 'Compliance', 'Preview & Submit'];
  let step = 0;
  let tenderId = null;
  const data = { boq: [] };
  let ref = null;

  function stepEls() {
    return STEPS.map((s, i) => `<div class="step ${i === step ? 'active' : ''} ${i < step ? 'done' : ''}" onclick="go(${i})">${i + 1}. ${s}</div>`).join('');
  }
  function renderSteps() { document.getElementById('wiz-steps').innerHTML = stepEls(); document.getElementById('btn-prev').style.visibility = step === 0 ? 'hidden' : 'visible'; document.getElementById('btn-next').textContent = step === STEPS.length - 1 ? 'Submit for Approval' : 'Next →'; }

  function opts(arr, key, labelKey) {
    return '<option value="">— Select —</option>' + arr.map(o => `<option value="${o[key]}">${esc(o[labelKey] || o[key])}</option>`).join('');
  }
  function v(id) { const el = document.getElementById(id); return el ? el.value : null; }

  const BODIES = [
    // 0 Basic
    () => `
      <div class="form-row">
        <div class="field"><label>Financial Year <span class="req">*</span></label><select id="t-fy">${opts(ref.financialYears, 'id', 'label')}</select></div>
        <div class="field"><label>Procurement Category <span class="req">*</span></label><select id="t-cat"><option value="">—</option><option>works</option><option>supply</option><option>services</option><option>consultancy</option><option>other</option></select></div>
        <div class="field"><label>Tender Type <span class="req">*</span></label><select id="t-type"><option value="">—</option><option>open</option><option>limited</option><option>e-tender</option><option>quotation</option><option>short_notice</option><option>single</option></select></div>
        <div class="field"><label>Rule Set</label><select id="t-ruleset">${opts(ref.rulesets, 'id', 'name')}</select></div>
      </div>
      <div class="form-row">
        <div class="field"><label>Work Name <span class="req">*</span></label><input id="t-work" placeholder="e.g. Construction of CC road…"></div>
        <div class="field"><label>Title</label><input id="t-title" placeholder="Tender title"></div>
      </div>
      <div class="form-row">
        <div class="field"><label>Scheme</label><select id="t-scheme">${opts(ref.schemes, 'id', 'name')}</select></div>
        <div class="field"><label>Fund</label><select id="t-fund">${opts(ref.funds, 'id', 'name')}</select></div>
      </div>
      <div class="form-row">
        <div class="field"><label>Location</label><input id="t-location" placeholder="Mouza / village"></div>
        <div class="field"><label>Description</label><textarea id="t-desc"></textarea></div>
      </div>`,
    // 1 Approvals
    () => `
      <h3 style="margin-top:0">Administrative Approval</h3>
      <div class="form-row">
        <div class="field"><label>Approval No. <span class="req">*</span></label><input id="t-aa-no"></div>
        <div class="field"><label>Date</label><input type="date" id="t-aa-date"></div>
        <div class="field"><label>Authority</label><input id="t-aa-auth"></div>
        <div class="field"><label>Amount (₹)</label><input type="number" step="0.01" id="t-aa-amt"></div>
      </div>
      <h3>Technical Sanction</h3>
      <div class="form-row">
        <div class="field"><label>Sanction No. <span class="req">*</span></label><input id="t-ts-no"></div>
        <div class="field"><label>Date</label><input type="date" id="t-ts-date"></div>
        <div class="field"><label>Authority</label><input id="t-ts-auth"></div>
        <div class="field"><label>Approved Amount (₹)</label><input type="number" step="0.01" id="t-ts-amt"></div>
      </div>`,
    // 2 Financial
    () => `
      <div class="form-row">
        <div class="field"><label>Estimated Cost (₹) <span class="req">*</span></label><input type="number" step="0.01" id="t-est"></div>
        <div class="field"><label>Tender Value (₹)</label><input type="number" step="0.01" id="t-tval"></div>
        <div class="field"><label>EMD (₹)</label><input type="number" step="0.01" id="t-emd"></div>
        <div class="field"><label>Tender Fee (₹)</label><input type="number" step="0.01" id="t-fee"></div>
      </div>
      <div class="form-row">
        <div class="field"><label>Security Deposit (₹)</label><input type="number" step="0.01" id="t-sd"></div>
        <div class="field"><label>Budget Provision</label><input id="t-budget"></div>
        <div class="field"><label>Head of Account</label><input id="t-hoa"></div>
      </div>`,
    // 3 Technical & BOQ
    () => `
      <div class="form-row">
        <div class="field"><label>Completion Period (days)</label><input type="number" id="t-period"></div>
        <div class="field" style="grid-column:span 2"><label>Technical Specification</label><textarea id="t-spec"></textarea></div>
      </div>
      <h3>BOQ Items</h3>
      <div class="table-wrap"><table class="table">
        <thead><tr><th>Item No.</th><th>Description</th><th>Unit</th><th class="num">Qty</th><th class="num">Rate (₹)</th><th class="num">Tax %</th><th></th></tr></thead>
        <tbody id="boq-rows"></tbody>
      </table></div>
      <button type="button" class="btn sm" onclick="addBoq()">+ Add item</button>
      <div id="boq-total" class="muted" style="margin-top:8px"></div>`,
    // 4 Eligibility & Schedule
    () => `
      <div class="field" style="margin-bottom:14px"><label>Eligibility</label><textarea id="t-elig"></textarea></div>
      <div class="form-row">
        <div class="field"><label>Publication Date</label><input type="date" id="t-pub"></div>
        <div class="field"><label>Bid Start</label><input type="date" id="t-bstart"></div>
        <div class="field"><label>Bid Closing</label><input type="date" id="t-bclose"></div>
        <div class="field"><label>Bid Validity (days)</label><input type="number" id="t-valid"></div>
      </div>
      <div class="form-row">
        <div class="field"><label>Technical Opening</label><input type="date" id="t-topen"></div>
        <div class="field"><label>Financial Opening</label><input type="date" id="t-fopen"></div>
      </div>`,
    // 5 Conditions
    () => `
      <div class="form-row">
        <div class="field"><label>General Conditions</label><textarea id="t-gcond"></textarea></div>
        <div class="field"><label>Special Conditions</label><textarea id="t-scond"></textarea></div>
      </div>
      <div class="form-row">
        <div class="field"><label>Payment Conditions</label><textarea id="t-pcond"></textarea></div>
        <div class="field"><label>Completion Conditions</label><textarea id="t-ccond"></textarea></div>
      </div>
      <div class="form-row">
        <div class="field"><label>Extension Conditions</label><textarea id="t-econd"></textarea></div>
        <div class="field"><label>Penalty Provisions</label><textarea id="t-pen"></textarea></div>
        <div class="field"><label>Defect Liability</label><textarea id="t-defect"></textarea></div>
      </div>`,
    // 6 Documents
    () => `
      <p class="muted">Upload supporting documents to the tender file room.</p>
      <div class="form-row">
        <div class="field"><label>Category</label><select id="doc-cat">
          <option value="estimate">Estimate</option>
          <option value="administrative_approval">Administrative Approval</option>
          <option value="technical_sanction">Technical Sanction</option>
          <option value="nit">NIT</option>
          <option value="tender_document">Tender Document</option>
          <option value="boq">BOQ</option>
          <option value="drawing">Drawing</option>
          <option value="other">Other</option>
        </select></div>
        <div class="field"><label>File</label><input type="file" id="doc-file"></div>
        <div class="field" style="justify-content:flex-end"><button class="btn" onclick="uploadDoc()">Upload</button></div>
      </div>
      <div class="doc-grid" id="doc-list"></div>`,
    // 7 Compliance
    () => `<div id="compliance-box"><div class="muted">Run the compliance check to continue.</div></div>`,
    // 8 Preview & Submit
    () => `<div id="preview-box"></div>`,
  ];

  function addBoq() {
    data.boq.push({ item_no: String(data.boq.length + 1), description: '', unit: '', quantity: 0, estimated_rate_minor: 0, tax_pct: 0 });
    renderBoq();
  }
  function renderBoq() {
    const tbody = document.getElementById('boq-rows');
    tbody.innerHTML = data.boq.map((b, i) => `
      <tr>
        <td><input id="boq-no-${i}" value="${esc(b.item_no)}" style="width:70px"></td>
        <td><input id="boq-desc-${i}" value="${esc(b.description)}"></td>
        <td><input id="boq-unit-${i}" value="${esc(b.unit || '')}" style="width:80px"></td>
        <td class="num"><input type="number" step="0.001" id="boq-qty-${i}" value="${b.quantity}" style="width:90px"></td>
        <td class="num"><input type="number" step="0.01" id="boq-rate-${i}" value="${(b.estimated_rate_minor || 0) / 100}" style="width:110px"></td>
        <td class="num"><input type="number" step="0.01" id="boq-tax-${i}" value="${b.tax_pct}" style="width:70px"></td>
        <td><button class="btn sm danger" onclick="data.boq.splice(${i},1);renderBoq()">✕</button></td>
      </tr>`).join('');
    const total = data.boq.reduce((s, b) => s + (Number(b.quantity) || 0) * ((b.estimated_rate_minor || 0) / 100), 0);
    document.getElementById('boq-total').textContent = 'Estimated BOQ total: ' + fmtINR(total) + ' (before tax)';
  }
  function collectBoq() {
    data.boq = data.boq.map((b, i) => ({
      item_no: document.getElementById(`boq-no-${i}`).value || String(i + 1),
      description: document.getElementById(`boq-desc-${i}`).value,
      unit: document.getElementById(`boq-unit-${i}`).value,
      quantity: Number(document.getElementById(`boq-qty-${i}`).value) || 0,
      estimated_rate_minor: Math.round((Number(document.getElementById(`boq-rate-${i}`).value) || 0) * 100),
      tax_pct: Number(document.getElementById(`boq-tax-${i}`).value) || 0,
    }));
    renderBoq();
  }

  async function uploadDoc() {
    const file = document.getElementById('doc-file').files[0];
    if (!file) return toast('Choose a file first', 'warning');
    const fd = new FormData();
    fd.append('file', file);
    fd.append('entity_type', 'tender');
    fd.append('entity_id', tenderId);
    fd.append('category', document.getElementById('doc-cat').value);
    await API.upload('/api/documents', fd);
    toast('Document uploaded', 'success');
    document.getElementById('doc-file').value = '';
    loadDocs();
  }
  async function loadDocs() {
    const d = await API.get('/api/tenders/' + tenderId);
    document.getElementById('doc-list').innerHTML = d.data.documents.length
      ? d.data.documents.map(doc => `<div class="doc-card"><div class="name">${esc(doc.original_name)}</div><div class="muted">${esc(doc.category)} · ${doc.size_bytes} B</div></div>`).join('')
      : '<div class="muted">No documents yet</div>';
  }

  async function runCompliance() {
    const d = await API.post('/api/tenders/' + tenderId + '/compliance', {});
    const f = d.data.findings;
    document.getElementById('compliance-box').innerHTML =
      `<div class="alert ${d.data.summary.blocking ? 'danger' : (d.data.summary.warning ? 'warning' : 'success')}">
        Blocking: ${d.data.summary.blocking} · Warnings: ${d.data.summary.warning} · Passed: ${d.data.summary.passed} · Verification required: ${d.data.summary.verification_required}
      </div>` +
      f.map(x => `
        <div class="finding ${x.severity}">
          <div class="f-head"><span class="f-title">${x.severityLabel} — ${esc(x.ruleTitle)}</span><span class="badge ${x.severity}">${x.status}</span></div>
          <div>${esc(x.message)}</div>
          <div class="f-meta"><strong>Why:</strong> ${esc(x.why || '')}</div>
          ${x.action ? `<div class="f-meta"><strong>Action:</strong> ${esc(x.action)}</div>` : ''}
          ${x.source ? `<div class="f-source">Source: ${esc(x.source.reference_number || '')} — ${esc(x.source.title || '')} ${x.source.source_url ? `(<a href="${esc(x.source.source_url)}" target="_blank">link</a>)` : ''}</div>` : ''}
        </div>`).join('');
  }

  async function saveStep() {
    const p = { ruleset_id: v('t-ruleset') || null, scheme_id: v('t-scheme') || null, fund_id: v('t-fund') || null };
    if (step === 0) {
      if (!v('t-fy')) throw new Error('Financial year is required');
      if (!v('t-cat')) throw new Error('Procurement category is required');
      if (!v('t-type')) throw new Error('Tender type is required');
      if (!v('t-work')) throw new Error('Work name is required');
      const body = { fy_id: Number(v('t-fy')), procurement_category: v('t-cat'), tender_type: v('t-type'), ruleset_id: v('t-ruleset') || null, scheme_id: v('t-scheme') || null, fund_id: v('t-fund') || null, title: v('t-title'), work_name: v('t-work'), description: v('t-desc'), location: v('t-location') };
      if (!tenderId) {
        const d = await API.post('/api/tenders', body);
        tenderId = d.data.id;
      } else {
        await API.put('/api/tenders/' + tenderId, body);
      }
    } else if (step === 1) {
      await API.put('/api/tenders/' + tenderId, {
        admin_approval_no: v('t-aa-no'), admin_approval_date: v('t-aa-date'), admin_approval_authority: v('t-aa-auth'), admin_approval_amount_minor: v('t-aa-amt') ? Math.round(Number(v('t-aa-amt')) * 100) : null,
        tech_sanction_no: v('t-ts-no'), tech_sanction_date: v('t-ts-date'), tech_sanction_authority: v('t-ts-auth'), tech_sanction_amount_minor: v('t-ts-amt') ? Math.round(Number(v('t-ts-amt')) * 100) : null,
      });
    } else if (step === 2) {
      await API.put('/api/tenders/' + tenderId, {
        estimated_cost_minor: v('t-est') ? Math.round(Number(v('t-est')) * 100) : 0,
        tender_value_minor: v('t-tval') ? Math.round(Number(v('t-tval')) * 100) : null,
        emd_minor: v('t-emd') ? Math.round(Number(v('t-emd')) * 100) : null,
        tender_fee_minor: v('t-fee') ? Math.round(Number(v('t-fee')) * 100) : null,
        security_deposit_minor: v('t-sd') ? Math.round(Number(v('t-sd')) * 100) : null,
        budget_provision: v('t-budget'), head_of_account: v('t-hoa'),
      });
    } else if (step === 3) {
      collectBoq();
      await API.put('/api/tenders/' + tenderId, { completion_period_days: v('t-period') ? Number(v('t-period')) : null, technical_specification: v('t-spec') });
      await API.post('/api/tenders/' + tenderId + '/boq', { items: data.boq });
    } else if (step === 4) {
      await API.put('/api/tenders/' + tenderId, {
        eligibility_notes: v('t-elig'), publication_date: v('t-pub'), bid_start_date: v('t-bstart'), bid_close_date: v('t-bclose'),
        bid_validity_days: v('t-valid') ? Number(v('t-valid')) : null, technical_open_date: v('t-topen'), financial_open_date: v('t-fopen'),
      });
    } else if (step === 5) {
      await API.put('/api/tenders/' + tenderId, {
        general_conditions: v('t-gcond'), special_conditions: v('t-scond'), payment_conditions: v('t-pcond'),
        completion_conditions: v('t-ccond'), extension_conditions: v('t-econd'), penalty_provisions: v('t-pen'), defect_liability: v('t-defect'),
      });
    } else if (step === 6) {
      loadDocs();
    } else if (step === 7) {
      await runCompliance();
    } else if (step === 8) {
      const d = await API.get('/api/tenders/' + tenderId);
      const t = d.data.tender;
      document.getElementById('preview-box').innerHTML = `
        <div class="panel"><div class="panel-head">${esc(t.tender_number)}</div><div class="panel-body">
          <table class="table">
            <tr><th>Work</th><td>${esc(t.work_name || t.title)}</td></tr>
            <tr><th>Type / Category</th><td>${esc(t.tender_type)} / ${esc(t.procurement_category)}</td></tr>
            <tr><th>Estimated Cost</th><td>${fmtINR((t.estimated_cost_minor || 0) / 100)}</td></tr>
            <tr><th>Admin Approval</th><td>${esc(t.admin_approval_no || '—')}</td></tr>
            <tr><th>Technical Sanction</th><td>${esc(t.tech_sanction_no || '—')}</td></tr>
            <tr><th>Bid Close</th><td>${fmtDate(t.bid_close_date)}</td></tr>
          </table>
        </div></div>`;
    }
  }

  async function goNext() {
    try {
      await saveStep();
      if (step < STEPS.length - 1) { step += 1; render(); } else { await doSubmit(); }
    } catch (e) { toast(e.message, 'danger'); }
  }
  function go(i) { step = i; render(); }

  async function doSubmit() {
    if (!tenderId) throw new Error('Tender not created');
    await API.post('/api/tenders/' + tenderId + '/submit', {});
    toast('Tender submitted for approval', 'success');
    setTimeout(() => window.location.href = '/tenders/' + tenderId, 800);
  }

  function render() {
    renderSteps();
    document.getElementById('wiz-body').innerHTML = BODIES[step]();
    if (step === 3) renderBoq();
    if (step === 6) loadDocs();
    if (step === 8) saveStep().catch(() => {});
  }

  (async function init() {
    const r = await API.get('/api/reference');
    ref = r.data;
    render();
  })();
</script>
</body>
</html>
