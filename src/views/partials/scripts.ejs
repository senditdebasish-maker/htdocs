<script>
  // Shared client helpers. NOTE: all authorization is enforced server-side;
  // these helpers are UX conveniences only.
  const API = {
    get: async (url) => { const r = await fetch(url, { headers: { 'Accept': 'application/json' } }); return handle(r); },
    post: async (url, body) => { const r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify(body || {}) }); return handle(r); },
    put: async (url, body) => { const r = await fetch(url, { method: 'PUT', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify(body || {}) }); return handle(r); },
    del: async (url) => { const r = await fetch(url, { method: 'DELETE', headers: { 'Accept': 'application/json' } }); return handle(r); },
    upload: async (url, formData) => { const r = await fetch(url, { method: 'POST', body: formData }); return handle(r); }
  };
  async function handle(r) {
    let body = null;
    try { body = await r.json(); } catch (_) { body = null; }
    if (!r.ok) {
      const msg = (body && body.error && body.error.message) || ('Request failed (' + r.status + ')');
      throw new Error(msg);
    }
    return body;
  }
  function fmtINR(v) {
    if (v === null || v === undefined || v === '') return '—';
    const n = Number(v);
    if (Number.isNaN(n)) return String(v);
    return '₹' + n.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }
  function fmtDate(iso) {
    if (!iso) return '—';
    const d = new Date(String(iso).slice(0, 10) + 'T00:00:00');
    if (Number.isNaN(d.getTime())) return iso;
    return d.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
  }
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function toast(msg, type) {
    const el = document.getElementById('toasts') || document.body;
    const t = document.createElement('div');
    t.className = 'alert ' + (type || 'info');
    t.style.marginBottom = '8px';
    t.textContent = msg;
    el.prepend(t);
    setTimeout(() => t.remove(), 5000);
  }
  (async function loadWhoami() {
    try {
      const d = await API.get('/api/auth/me');
      document.getElementById('whoami').textContent = d.data.user.name;
      const unread = await API.get('/api/notifications?unread=1');
      document.getElementById('unread-count').textContent = unread.data.unread ? '(' + unread.data.unread + ')' : '';
    } catch (_) { /* not logged in */ }
  })();
</script>
