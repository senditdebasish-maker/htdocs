<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Public Portal' }) %>
  <style>
    body { background: #fff; }
    .pub-header { background: var(--primary); color: #fff; padding: 26px 22px; }
    .pub-header h1 { margin: 0; font-size: 20px; }
    .pub-header .sub { opacity: .85; font-size: 13px; }
    .pub-content { max-width: 1100px; margin: 20px auto; padding: 0 16px 40px; }
  </style>
</head>
<body>
  <div class="pub-header">
    <div style="max-width:1100px;margin:0 auto">
      <h1><%= config.systemShortName %> — Public Tenders</h1>
      <div class="sub">Public information only. No confidential bid or financial data is exposed.</div>
    </div>
  </div>
  <div class="pub-content">
    <div class="form-row" style="grid-template-columns:220px">
      <div class="field"><label>Financial Year</label>
        <select onchange="location.href='/public' + (this.value ? '?fyId=' + this.value : '')">
          <option value="">All years</option>
          <% fys.forEach(function (f) { %>
            <option value="<%= f.id %>" <%= activeFy === f.id ? 'selected' : '' %>><%= f.label %></option>
          <% }); %>
        </select>
      </div>
    </div>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Tender No.</th><th>Work</th><th>Location</th><th>FY</th><th class="num">Estimated Cost</th><th>Bid Close</th><th>Status</th></tr></thead>
        <tbody>
          <% if (!tenders.length) { %>
            <tr><td colspan="7"><div class="empty"><div class="big">📄</div>No published tenders.</div></td></tr>
          <% } else { %>
            <% tenders.forEach(function (t) { %>
              <tr>
                <td class="mono"><%= t.tender_number %></td>
                <td><%= t.work_name || t.title %></td>
                <td><%= t.location || '—' %></td>
                <td><%= t.fy_label %></td>
                <td class="num"><%= money.formatMinorINR(t.estimated_cost_minor) %></td>
                <td><%= dates.formatDate(t.bid_close_date) %></td>
                <td><span class="badge <%= t.status %>"><%= t.status.replace(/_/g, ' ') %></span></td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
    <div class="footer-note">
      This is an administrative management system. It is <strong>not</strong> the official Government of West Bengal e-procurement platform.
      Official tenders are published on <a href="https://wbtenders.gov.in" target="_blank" rel="noopener">wbtenders.gov.in</a> and the
      <a href="https://prd.wb.gov.in" target="_blank" rel="noopener">P&RD Department website</a>. Details shown here are for information only.
    </div>
  </div>
</body>
</html>
