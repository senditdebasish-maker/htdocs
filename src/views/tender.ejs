<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Tender Detail' }) %>
</head>
<body>
<div class="layout">
  <%- include('partials/sidebar') %>
  <div class="main">
    <%- include('partials/topbar', { breadcrumbs: [{ label: 'Tenders', url: '/tenders' }, { label: 'Detail' }] }) %>
    <div class="content">
      <div id="toasts"></div>
      <div class="panel">
        <div class="panel-body">
          <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px">
            <div>
              <h1 class="page-title mono" id="t-number">…</h1>
              <div id="t-title" style="font-size:15px"></div>
              <div class="muted" id="t-meta" style="margin-top:4px"></div>
            </div>
            <div id="actions" class="btn-row"></div>
          </div>
        </div>
      </div>

      <div class="tabs" id="tabs">
        <div class="tab active" data-tab="overview">Overview</div>
        <div class="tab" data-tab="boq">BOQ</div>
        <div class="tab" data-tab="compliance">Compliance</div>
        <div class="tab" data-tab="bids">Bidders &amp; Evaluation</div>
        <div class="tab" data-tab="award">Award</div>
        <div class="tab" data-tab="docs">Documents</div>
        <div class="tab" data-tab="timeline">Timeline</div>
      </div>

      <div class="tab-pane active" id="pane-overview"></div>
      <div class="tab-pane" id="pane-boq"></div>
      <div class="tab-pane" id="pane-compliance"></div>
      <div class="tab-pane" id="pane-bids"></div>
      <div class="tab-pane" id="pane-award"></div>
      <div class="tab-pane" id="pane-docs"></div>
      <div class="tab-pane" id="pane-timeline"></div>
    </div>
  </div>
</div>
<%- include('partials/scripts') %>
<script>
  const TID = <%= tenderId %>;
  let T = null, D = null, REF = null;
  let currentBidder = null;

  async function loadAll() {
    const d = await API.get('/api/tenders/' + TID);
    D = d.data; T = d.data.tender;
    const r = await API.get('/api/reference'); REF = r.data;
    document.getElementById('t-number').textContent = T.tender_number;
    document.getElementById('t-title').textContent = T.work_name || T.title;
    document.getElementById('t-meta').textContent = `${T.tender_type} · ${T.procurement_category} · FY ${T.fy_label || ''} · Estimated ${fmtINR((T.estimated_cost_minor || 0) / 100)}`;
    renderActions(); renderOverview(); renderBoq(); renderCompliance(); renderBids(); renderAward(); renderDocs(); renderTimeline();
  }

  function renderActions() {
    const a = [];
    if (T.status === 'draft') { a.push(b('Run Compliance', 'accent', runCompliance)); a.push(b('Submit for Approval', 'primary', submit)); }
    if (T.status === 'under_approval') { a.push(b('Approve Step', 'primary', () => workflow('approve'))); a.push(b('Return', '', () => workflow('return'))); }
    if (T.status === 'approved' || T.status === 'nit_generated') { a.push(b('Generate NIT', 'primary', genNit)); a.push(b('Publish', 'accent', publish)); }
    if (T.status === 'published') a.push(b('Start Bidding', 'primary', () => bidding()));
    if (T.status === 'bidding') a.push(b('Close Bids', 'accent', () => closeBids()));
    if (['approved', 'nit_generated', 'published', 'bidding', 'bid_closed'].includes(T.status)) { a.push(b('Corrigendum', '', corrigendum)); a.push(b('Cancel', 'danger', cancel)); }
    if (['bid_closed', 'technical_evaluation', 'financial_evaluation', 'cancelled'].includes(T.status)) a.push(b('Re-Tender', '', retender));
    document.getElementById('actions').innerHTML = a.join('');
  }
  function b(label, cls, fn) { return `<button class="btn ${cls}" onclick="(${fn.toString()})()">${label}</button>`; }

  function kv(rows) { return '<table class="table">' + rows.map(r => `<tr><th style="width:220px">${r[0]}</th><td>${esc(r[1])}</td></tr>`).join('') + '</table>'; }

  function renderOverview() {
    const t = T;
    document.getElementById('pane-overview').innerHTML =
      `<div class="panel"><div class="panel-head">Basic & Financial Information</div><div class="panel-body">` + kv([
        ['Tender No.', t.tender_number], ['NIT No.', t.nit_number || '—'], ['Status', `<span class="badge ${t.status}">${t.status.replace(/_/g, ' ')}</span>`], ['Type / Category', `${t.tender_type} / ${t.procurement_category}`],
        ['Scheme / Fund', `${D.scheme_name || '—'} / ${D.fund_name || '—'}`], ['Location', t.location || '—'],
        ['Estimated Cost', fmtINR((t.estimated_cost_minor || 0) / 100)], ['EMD', fmtINR((t.emd_minor || 0) / 100)], ['Tender Fee', fmtINR((t.tender_fee_minor || 0) / 100)],
        ['Security Deposit', fmtINR((t.security_deposit_minor || 0) / 100)], ['Head of Account', t.head_of_account || '—'],
        ['Admin Approval', `${t.admin_approval_no || '—'}${t.admin_approval_date ? ' (' + fmtDate(t.admin_approval_date) + ')' : ''}`],
        ['Technical Sanction', `${t.tech_sanction_no || '—'}${t.tech_sanction_date ? ' (' + fmtDate(t.tech_sanction_date) + ')' : ''}`],
        ['Bid Close', fmtDate(t.bid_close_date)], ['Technical Opening', fmtDate(t.technical_open_date)], ['Financial Opening', fmtDate(t.financial_open_date)],
      ]) + '</div></div>' +
      `<div class="panel"><div class="panel-head">Approval Workflow</div><div class="panel-body">${renderSteps()}</div></div>`;
  }
  function renderSteps() {
    const steps = D.steps || [];
    if (!steps.length) return '<div class="muted">Not yet submitted for approval.</div>';
    return '<table class="table"><thead><tr><th>#</th><th>Step</th><th>Required Role</th><th>Status</th><th>Action</th><th>Remarks</th></tr></thead><tbody>' +
      steps.map(s => `<tr><td>${s.step_order}</td><td>${esc(s.step_name)}</td><td>${esc(s.required_role || 'any')}</td><td><span class="badge ${s.status}">${s.status}</span></td><td>${esc(s.action || '—')}</td><td>${esc(s.remarks || '')}</td></tr>`).join('') + '</tbody></table>';
  }

  function renderBoq() {
    const items = D.boq || [];
    const tot = D.boqTotals || {};
    document.getElementById('pane-boq').innerHTML = `<div class="panel"><div class="panel-head">BOQ <span class="muted">(Estimated total: ${fmtINR((tot.totalMinor || 0) / 100)})</span></div><div class="panel-body no-pad"><div class="table-wrap"><table class="table">
      <thead><tr><th>Item</th><th>Description</th><th>Unit</th><th class="num">Qty</th><th class="num">Rate (₹)</th><th class="num">Tax %</th><th class="num">Amount (₹)</th></tr></thead><tbody>` +
      items.map(i => {
        const amt = (Number(i.quantity) || 0) * ((i.estimated_rate_minor || 0) / 100);
        return `<tr><td>${esc(i.item_no)}</td><td>${esc(i.description)}</td><td>${esc(i.unit || '')}</td><td class="num">${i.quantity}</td><td class="num">${fmtINR((i.estimated_rate_minor || 0) / 100)}</td><td class="num">${i.tax_pct || 0}</td><td class="num">${fmtINR(amt)}</td></tr>`;
      }).join('') + '</tbody></table></div></div></div>';
  }

  function renderCompliance() {
    const c = D.compliance;
    const box = document.getElementById('pane-compliance');
    if (!c) { box.innerHTML = `<div class="panel"><div class="panel-body"><div class="empty"><div class="big">🔍</div>Compliance checks not run yet.</div></div></div>`; return; }
    const s = c.summary || {};
    box.innerHTML = `<div class="panel"><div class="panel-head">Compliance Check Result <span class="muted">— passes the configured system checks (not a legal opinion)</span></div><div class="panel-body">
      <div class="alert ${s.blocking ? 'danger' : (s.warning ? 'warning' : 'success')}">Blocking: ${s.blocking} · Warnings: ${s.warning} · Verification required: ${s.verification_required} · Passed: ${s.passed}</div>
      ${(c.results || []).map(x => `
        <div class="finding ${x.severity}">
          <div class="f-head"><span class="f-title">${x.severityLabel} — ${esc(x.ruleTitle)}</span><span class="badge ${x.severity}">${x.status}</span></div>
          <div>${esc(x.message)}</div>
          ${x.why ? `<div class="f-meta"><strong>Why:</strong> ${esc(x.why)}</div>` : ''}
          ${x.action ? `<div class="f-meta"><strong>Action:</strong> ${esc(x.action)}</div>` : ''}
          ${x.source ? `<div class="f-source"><strong>Source:</strong> ${esc(x.source.reference_number || '')} — ${esc(x.source.title || '')} ${x.source.source_url ? `(<a href="${esc(x.source.source_url)}" target="_blank" rel="noopener">link</a>)` : ''}</div>` : ''}
        </div>`).join('')}</div></div>`;
  }

  function renderBids() {
    const bidders = D.bidders || [];
    const crit = D.criteria || [];
    const box = document.getElementById('pane-bids');
    let html = `<div class="panel"><div class="panel-head">Bidders (${bidders.length})</div><div class="panel-body">`;
    if (['bidding', 'bid_closed', 'technical_evaluation'].includes(T.status)) {
      html += `<div class="form-row" style="grid-template-columns:1fr auto">
        <div class="field"><label>Add Bidder (contractor)</label><select id="bid-contractor">${REF.contractors.map(c => `<option value="${c.id}">${esc(c.legal_name)}${c.status === 'debarred' ? ' (DEBARRED)' : ''}</option>`).join('')}</select></div>
        <div class="field" style="justify-content:flex-end"><button class="btn primary" onclick="addBidder()">Add Bidder</button></div>
      </div>`;
    }
    if (T.status === 'bid_closed') {
      html += `<div class="btn-row" style="margin-bottom:10px">${b('Record Technical Opening', 'primary', techOpen)}</div>`;
    }
    if (!bidders.length) html += '<div class="muted">No bidders recorded yet.</div>';
    else html += '<table class="table"><thead><tr><th>Bidder</th><th>Submitted</th><th>EMD</th><th>Status</th><th>Rank</th><th>Quoted (₹)</th><th>Rejection</th></tr></thead><tbody>' +
      bidders.map(bd => {
        const fb = (D.financialBids || []).find(f => f.bidder_id === bd.id);
        return `<tr><td>${esc(bd.legal_name || bd.business_name)}</td><td>${fmtDate(bd.submission_time)}</td><td>${fmtINR((bd.emd_paid_minor || 0) / 100)}</td><td><span class="badge ${bd.bid_status}">${bd.bid_status.replace(/_/g, ' ')}</span></td><td>${bd.rank ? 'L' + bd.rank : '—'}</td><td>${fb ? fmtINR((fb.total_amount_minor || 0) / 100) : '—'}</td><td>${esc(bd.rejection_reason || '')}</td></tr>`;
      }).join('') + '</tbody></table>';
    html += '</div></div>';

    // Technical evaluation UI
    if (['technical_evaluation', 'financial_evaluation', 'awarded', 'closed'].includes(T.status)) {
      html += `<div class="panel"><div class="panel-head">Technical Evaluation</div><div class="panel-body">`;
      if (T.status === 'technical_evaluation') {
        html += `<div class="form-row"><div class="field"><label>New Criterion</label><input id="crit-name" placeholder="e.g. Valid Registration"></div>
          <div class="field"><label>Requirement</label><input id="crit-req" placeholder="Submitted"></div>
          <div class="field" style="justify-content:flex-end"><button class="btn" onclick="addCriterion()">+ Add</button></div></div>`;
      }
      if (crit.length && bidders.length) {
        html += '<div class="table-wrap"><table class="table"><thead><tr><th>Bidder</th>' + crit.map(c => `<th>${esc(c.criterion)}</th>`).join('') + '<th></th></tr></thead><tbody>';
        for (const bd of bidders) {
          html += `<tr><td>${esc(bd.legal_name || bd.business_name)}</td>`;
          for (const c of crit) {
            const evalRow = (D.evaluations || []).find(e => e.bidder_id === bd.id && e.criterion_id === c.id);
            const result = evalRow ? evalRow.result : null;
            html += `<td>${T.status === 'technical_evaluation' ? `<select onchange="setEval(${bd.id}, ${c.id}, this.value)">
              <option value="">—</option><option value="pass" ${result === 'pass' ? 'selected' : ''}>Pass</option>
              <option value="fail" ${result === 'fail' ? 'selected' : ''}>Fail</option>
              <option value="clarification_required" ${result === 'clarification_required' ? 'selected' : ''}>Clarify</option>
              <option value="not_applicable" ${result === 'not_applicable' ? 'selected' : ''}>N/A</option>
              <option value="verification_required" ${result === 'verification_required' ? 'selected' : ''}>Verify</option>
            </select>` : `<span class="badge ${result || 'info'}">${result || '—'}</span>`}</td>`;
          }
          html += `<td>${bd.bid_status === 'technically_qualified' ? '<span class="badge qualified">Qualified</span>' : (bd.bid_status === 'technically_disqualified' ? '<span class="badge disqualified">Disqualified</span>' : '')}</td></tr>`;
        }
        html += '</tbody></table></div>';
        if (T.status === 'technical_evaluation') html += `<button class="btn primary" onclick="finalizeTech()">Finalize Technical Evaluation</button>`;
      } else html += '<div class="muted">Add criteria to evaluate bidders.</div>';
      html += '</div></div>';
    }
    box.innerHTML = html;
  }

  function renderAward() {
    const box = document.getElementById('pane-award');
    if (!['financial_evaluation', 'awarded', 'closed'].includes(T.status)) {
      box.innerHTML = '<div class="panel"><div class="panel-body"><div class="empty"><div class="big">🏆</div>Award workflow starts after financial evaluation.</div></div></div>';
      return;
    }
    const bidders = D.bidders || [];
    const qualified = bidders.filter(bd => ['technically_qualified', 'financial_opened', 'awarded'].includes(bd.bid_status));
    const award = D.award;
    let html = '';

    if (T.status === 'financial_evaluation') {
      html += `<div class="panel"><div class="panel-head">Record Financial Bids (confidential)</div><div class="panel-body">`;
      if (!qualified.length) html += '<div class="muted">No technically qualified bidders.</div>';
      else html += '<table class="table"><thead><tr><th>Bidder</th><th>Quoted Total (₹)</th><th>Quoted Total (minor)</th><th></th></tr></thead><tbody>' +
        qualified.map(bd => `<tr><td>${esc(bd.legal_name || bd.business_name)}</td>
          <td><input type="number" step="0.01" id="fb-amt-${bd.id}" placeholder="e.g. 950000"></td>
          <td><span class="muted" id="fb-minor-${bd.id}">—</span></td>
          <td><button class="btn sm" onclick="recordFinBid(${bd.id})">Save</button></td></tr>`).join('') + '</tbody></table>';
      html += `<button class="btn primary" onclick="computeRanks()">Compute L1/L2/L3</button> <button class="btn accent" onclick="comparativePdf()">Comparative PDF</button></div></div>`;
      html += `<div class="panel"><div class="panel-head">Award Recommendation</div><div class="panel-body">
        <div class="form-row"><div class="field"><label>Qualified Bidder</label><select id="aw-bidder">${qualified.map(bd => `<option value="${bd.id}" data-c="${bd.contractor_id}">${esc(bd.legal_name || bd.business_name)}${bd.rank ? ' (L' + bd.rank + ')' : ''}</option>`).join('')}</select></div>
        <div class="field"><label>Award Amount (₹)</label><input type="number" step="0.01" id="aw-amt"></div></div>
        <button class="btn primary" onclick="recommend()">Recommend Award</button></div></div>`;
    } else if (award) {
      html += `<div class="panel"><div class="panel-head">Award</div><div class="panel-body">` + kv([
        ['Contractor', award.contractor_name || award.contractor_id], ['Awarded Amount', fmtINR((award.awarded_amount_minor || 0) / 100)],
        ['Status', `<span class="badge ${award.status}">${award.status}</span>`], ['LOA', award.loa_number || '—'],
        ['Approval Authority', award.approval_authority || '—'], ['Approval Date', fmtDate(award.approval_date)],
      ]) + `<div class="btn-row" style="margin-top:10px">
        ${award.status === 'recommended' ? b('Approve Award', 'primary', () => approveAward(award.id)) : ''}
        ${award.status === 'approved' ? b('Issue LOA (PDF)', 'primary', () => issueLoa(award.id)) : ''}
        ${award.status === 'loa_issued' ? b('Create Agreement', 'primary', () => createAgreement(award.id)) : ''}
        ${award.status === 'agreement_done' ? b('Issue Work Order', 'primary', () => issueWorkOrder(award.id)) : ''}
        ${['approved', 'loa_issued', 'agreement_done', 'work_order_issued'].includes(award.status) && award.agreement_id ? b('Generate Agreement PDF', '', () => {}) : ''}
      </div></div></div>`;
    }
    box.innerHTML = html;
  }

  function renderDocs() {
    const docs = D.documents || [];
    document.getElementById('pane-docs').innerHTML = `<div class="panel"><div class="panel-head">File Room (${docs.length})</div><div class="panel-body">
      <div class="form-row"><div class="field"><label>Category</label><select id="d-cat">
        <option>estimate</option><option>administrative_approval</option><option>technical_sanction</option><option>nit</option><option>tender_document</option><option>boq</option><option>drawing</option><option>other</option>
      </select></div><div class="field"><label>File</label><input type="file" id="d-file"></div><div class="field" style="justify-content:flex-end"><button class="btn" onclick="upDoc()">Upload</button></div></div>
      <div class="doc-grid">${docs.map(doc => `<div class="doc-card"><div class="name">${esc(doc.original_name)}</div><div class="muted">${esc(doc.category)} · ${fmtDate(doc.created_at)}</div><a href="/api/documents/${doc.id}/download">Download</a></div>`).join('') || '<div class="muted">No documents</div>'}</div>
    </div></div>`;
  }
  async function upDoc() {
    const file = document.getElementById('d-file').files[0];
    if (!file) return toast('Choose a file', 'warning');
    const fd = new FormData(); fd.append('file', file); fd.append('entity_type', 'tender'); fd.append('entity_id', TID); fd.append('category', document.getElementById('d-cat').value);
    await API.upload('/api/documents', fd);
    toast('Uploaded', 'success'); loadAll();
  }

  function renderTimeline() {
    const order = ['draft', 'under_approval', 'approved', 'nit_generated', 'published', 'bidding', 'bid_closed', 'technical_evaluation', 'financial_evaluation', 'awarded', 'closed'];
    const labels = { draft: 'Draft', under_approval: 'Approval', approved: 'Approved', nit_generated: 'NIT', published: 'Published', bidding: 'Bidding', bid_closed: 'Bid Closed', technical_evaluation: 'Technical', financial_evaluation: 'Financial', awarded: 'Award', closed: 'Closed' };
    const idx = order.indexOf(T.status);
    const extra = ['cancelled', 'retendered'].includes(T.status);
    let html = '<ul class="timeline">';
    if (extra) html += `<li class="blocked"><span class="dot"></span><div class="t-title">${T.status}</div><div class="t-time">This tender is ${T.status}.</div></li>`;
    order.forEach((s, i) => {
      const cls = i < idx ? 'done' : i === idx ? 'current' : '';
      html += `<li class="${cls}"><span class="dot"></span><div class="t-title">${labels[s]}</div>${i === idx ? '<div class="t-time">Current stage</div>' : ''}</li>`;
    });
    html += '</ul>';
    html += `<div class="panel"><div class="panel-head">Version History</div><div class="panel-body no-pad"><div class="table-wrap"><table class="table">
      <thead><tr><th>Ver</th><th>Change</th><th>Reason</th><th>When</th></tr></thead><tbody>` +
      (D.versions || []).slice().reverse().map(v => `<tr><td>${v.version_no}</td><td>${esc(v.change_type)}</td><td>${esc(v.reason || '')}</td><td>${v.created_at}</td></tr>`).join('') + '</tbody></table></div></div></div>';
    document.getElementById('pane-timeline').innerHTML = html;
  }

  // ---- Lifecycle actions ----
  async function runCompliance() { await API.post('/api/tenders/' + TID + '/compliance', {}); toast('Compliance checked', 'success'); loadAll(); }
  async function submit() { await API.post('/api/tenders/' + TID + '/submit', {}); toast('Submitted', 'success'); loadAll(); }
  async function workflow(action) { const remarks = prompt('Remarks:'); await API.post('/api/tenders/' + TID + '/workflow', { action, remarks }); toast('Workflow updated', 'success'); loadAll(); }
  async function genNit() { const r = await API.post('/api/tenders/' + TID + '/nit', {}); toast('NIT generated', 'success'); window.open('/api/generated/' + r.data.document.id + '/download'); loadAll(); }
  async function publish() { await API.post('/api/tenders/' + TID + '/publish', {}); toast('Published', 'success'); loadAll(); }
  async function bidding() { await API.post('/api/tenders/' + TID + '/bidding', {}); toast('Bidding started', 'success'); loadAll(); }
  async function closeBids() { await API.post('/api/tenders/' + TID + '/close-bids', {}); toast('Bids closed', 'success'); loadAll(); }
  async function cancel() { const reason = prompt('Reason for cancellation:'); if (!reason) return; await API.post('/api/tenders/' + TID + '/cancel', { reason }); toast('Cancelled', 'success'); loadAll(); }
  async function corrigendum() { const reason = prompt('Corrigendum reason:'); if (!reason) return; const field = prompt('Changed field (e.g. bid_close_date):'); const oldv = prompt('Old value:'); const newv = prompt('New value:'); await API.post('/api/tenders/' + TID + '/corrigendum', { reason, changes: [{ field, old_value: oldv, new_value: newv }] }); toast('Corrigendum created', 'success'); loadAll(); }
  async function retender() { const reason = prompt('Re-tender reason:'); if (!reason) return; const r = await API.post('/api/tenders/' + TID + '/retender', { reason }); toast('Re-tender created: ' + r.data.tender_number, 'success'); window.location.href = '/tenders/' + r.data.id; }

  // ---- Bid / evaluation actions ----
  async function addBidder() { const cid = document.getElementById('bid-contractor').value; await API.post('/api/tenders/' + TID + '/bidders', { contractor_id: Number(cid) }); toast('Bidder added', 'success'); loadAll(); }
  async function techOpen() { await API.post('/api/tenders/' + TID + '/technical-open', {}); toast('Technical opening recorded', 'success'); loadAll(); }
  async function addCriterion() { const criterion = document.getElementById('crit-name').value; if (!criterion) return toast('Criterion required', 'warning'); await API.post('/api/tenders/' + TID + '/criteria', { code: criterion.replace(/\W+/g, '_').toUpperCase(), criterion, requirement: document.getElementById('crit-req').value }); toast('Criterion added', 'success'); loadAll(); }
  async function setEval(bidderId, criterionId, result) {
    if (!result) return;
    await API.post('/api/tenders/' + TID + '/evaluations', { bidder_id: bidderId, criterion_id: criterionId, result });
  }
  async function finalizeTech() {
    const fails = {};
    for (const bd of D.bidders) {
      if (bd.bid_status === 'technically_disqualified') { const r = prompt('Rejection reason for ' + (bd.legal_name || bd.business_name) + ':'); if (r) fails[bd.id] = r; }
    }
    // Determine from current evaluation data which bidders will fail:
    for (const bd of D.bidders) {
      const ev = (D.evaluations || []).filter(e => e.bidder_id === bd.id);
      if (ev.some(e => e.result === 'fail') && !fails[bd.id]) {
        const r = prompt('Rejection reason for ' + (bd.legal_name || bd.business_name) + ':'); if (r) fails[bd.id] = r;
      }
    }
    await API.post('/api/tenders/' + TID + '/finalize-technical', { rejectionReasons: fails });
    toast('Technical evaluation finalized', 'success'); loadAll();
  }
  async function recordFinBid(bidderId) {
    const amtInput = document.getElementById('fb-amt-' + bidderId).value;
    const minor = Math.round(Number(amtInput) * 100);
    document.getElementById('fb-minor-' + bidderId).textContent = minor + ' minor';
    await API.post('/api/tenders/' + TID + '/financial-bids', { bidder_id: bidderId, totalAmountMinor: minor });
    toast('Financial bid recorded', 'success'); loadAll();
  }
  async function computeRanks() { await API.post('/api/tenders/' + TID + '/rank', {}); toast('Rankings computed', 'success'); loadAll(); }
  async function comparativePdf() { toast('Comparative statement: see Reports / PDF', 'info'); }
  async function recommend() { const sel = document.getElementById('aw-bidder'); if (!sel) return; const cid = sel.options[sel.selectedIndex].dataset.c; await API.post('/api/awards/recommend', { tender_id: TID, contractor_id: Number(cid), awarded_amount_minor: Math.round(Number(document.getElementById('aw-amt').value) * 100) }); toast('Award recommended', 'success'); loadAll(); }
  async function approveAward(awardId) { await API.post('/api/awards/' + awardId + '/approve', {}); toast('Award approved', 'success'); loadAll(); }
  async function issueLoa(awardId) { const r = await API.post('/api/awards/' + awardId + '/loa', {}); toast('LOA issued', 'success'); window.open('/api/generated/' + r.data.document.id + '/download'); loadAll(); }
  async function createAgreement(awardId) { await API.post('/api/awards/' + awardId + '/agreement', {}); toast('Agreement created', 'success'); loadAll(); }
  async function issueWorkOrder(awardId) { await API.post('/api/awards/' + awardId + '/work-order', {}); toast('Work order issued', 'success'); loadAll(); }

  // Tab switching
  document.getElementById('tabs').addEventListener('click', (e) => {
    const tab = e.target.closest('.tab'); if (!tab) return;
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.tab-pane').forEach(t => t.classList.remove('active'));
    tab.classList.add('active');
    document.getElementById('pane-' + tab.dataset.tab).classList.add('active');
  });

  loadAll();
</script>
</body>
</html>
