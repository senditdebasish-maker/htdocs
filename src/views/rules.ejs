<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { title: 'Rules & Compliance' }) %></head>
<body>
<div class="layout">
  <%- include('partials/sidebar') %>
  <div class="main">
    <%- include('partials/topbar', { breadcrumbs: [{ label: 'Rules & Compliance' }] }) %>
    <div class="content">
      <h1 class="page-title">Rules &amp; Compliance Engine</h1>
      <p class="page-sub">Versioned, configurable rule sets backed by official reference sources.</p>
      <div class="alert info">
        <strong>Legal caution:</strong> rules encoded here are <strong>system checks based on cited sources</strong>. They are not legal advice and do not certify statutory compliance. Where a rule cannot be established confidently, it is marked <strong>Verification Required</strong>.
      </div>
      <div class="grid-2">
        <div class="panel"><div class="panel-head">Rule Sets</div><div class="panel-body no-pad"><div class="table-wrap"><table class="table">
          <thead><tr><th>Name</th><th>Authority</th><th>Version</th><th>Active</th></tr></thead>
          <tbody id="rulesets"></tbody>
        </table></div></div></div>
        <div class="panel"><div class="panel-head">Rules (selected rule set)</div><div class="panel-body no-pad"><div class="table-wrap"><table class="table">
          <thead><tr><th>Code</th><th>Title</th><th>Severity</th><th>Type</th></tr></thead>
          <tbody id="rules"></tbody>
        </table></div></div></div>
      </div>
      <div class="panel"><div class="panel-head">Official References &amp; Sources</div><div class="panel-body no-pad"><div class="table-wrap"><table class="table">
        <thead><tr><th>Title</th><th>Authority</th><th>Reference No.</th><th>Source</th></tr></thead>
        <tbody id="refs"></tbody>
      </table></div></div></div>
    </div>
  </div>
</div>
<%- include('partials/scripts') %>
<script>
  async function load() {
    const rs = await API.get('/api/rulesets');
    document.getElementById('rulesets').innerHTML = rs.data.rows.map(r => `<tr><td>${esc(r.name)}</td><td>${esc(r.issuing_authority || '—')}</td><td>v${r.version}</td><td>${r.is_active ? '✅' : '—'}</td></tr>`).join('');
    if (rs.data.rows.length) {
      const rules = await API.get('/api/rulesets/' + rs.data.rows[0].id + '/rules');
      document.getElementById('rules').innerHTML = rules.data.rows.map(r => `<tr><td class="mono">${esc(r.code)}</td><td>${esc(r.title)}</td><td><span class="badge ${r.severity}">${r.severity.replace(/_/g, ' ')}</span></td><td>${esc(r.rule_type)}</td></tr>`).join('');
    }
    const refs = await API.get('/api/rule-references');
    document.getElementById('refs').innerHTML = refs.data.rows.map(r => `<tr><td>${esc(r.title)}</td><td>${esc(r.authority)}</td><td>${esc(r.reference_number)}</td><td>${r.source_url ? `<a href="${esc(r.source_url)}" target="_blank">${esc(r.source_url)}</a>` : '—'}</td></tr>`).join('');
  }
  load();
</script>
</body>
</html>
